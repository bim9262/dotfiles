[theme]
theme = "solarized-dark"

[theme.overrides]
end_separator = "<span size='12pt' color='#93a1a1'>|</span>"
separator = "<span size='12pt'></span>"
good_bg = "#0dbc79"
alternating_tint_bg = "#181818"
alternating_tint_fg = "#181818"

[icons]
icons = "material-nf"

[geolocator]
geolocator = "ip2location"

[[block]]
block = "music"
format = " $icon {{"{{"}}$volume_icon $volume \\| |}$combo.str(max_w:25, rot_interval:0.1) \\| $prev $play $next |{ Player $cur of $avail \\| $prev $play $next| No players open} }"
seek_forward_step_secs = 15
seek_backward_step_secs = 10
interface_name_exclude = ["playerctld", "chromium.*"]
[[block.click]]
button = "left"
action = "play_pause"
[[block.click]]
button = "up"
action = "volume_up"
[[block.click]]
button = "down"
action = "volume_down"
[[block.click]]
button = "forward"
action = "next"
[[block.click]]
button = "back"
action = "prev"
[[block.click]]
button = "wheel_left"
action = "seek_backward"
[[block.click]]
button = "wheel_right"
action = "seek_forward"
[block.theme_overrides]
info_bg = { link = "good_bg" }

[[block]]
block = "calendar"
next_event_format = " $icon $start.datetime(f:'%a %H:%M') $summary.str(max_w:25, rot_interval:0.1) {$source|} "
ongoing_event_format = " $icon $summary.str(max_w:25, rot_interval:0.1) (ends at $end.datetime(f:'%H:%M')) {$source|} "
no_events_format = " $icon no events "
fetch_interval = 30
warning_threshold = 600
events_within_hours = 96
[[block.source]]
url = "https://apidata.googleusercontent.com/caldav/v2"
[block.source.auth]
type = "oauth2"
client_id = "249479960943-2a31c7plkpc8be8jflvluqhahhdo51q7.apps.googleusercontent.com"
client_secret = "{{ pass "i3status-rust/google-client-secret" }}"
auth_url = "https://accounts.google.com/o/oauth2/auth"
token_url = "https://oauth2.googleapis.com/token"
redirect_port = 8080
scopes = [
    "https://www.googleapis.com/auth/calendar",
    "https://www.googleapis.com/auth/calendar.events.readonly",
]

[[block]]
block = "weather"
format = " $icon $weather_verbose {$temp}C {$sunrise.datetime(f:'%H:%M')|err}/{$sunset.datetime(f:'%H:%M')|err} "
format_alt = " $icon_ffin Forecast (8 hours) {$weather_verbose_ffin {$temp_favg}C ({$temp_fmax}C/{$temp_fmin}C)|Unavailable} "
autolocate = true
autolocate_interval = "once"
[block.service]
name = "metno"
forecast_hours = 8

{{- if eq .chezmoi.hostname "bmalyn-yoga" }}
[[block]]
block = "net"
device = "wlp2s0"
format = " $icon {$signal_strength} "
[[block.click]]
button = "left"
cmd = "alacritty -e nmtui"
{{- end }}

[[block]]
block = "temperature"
interval = 1
format = " $icon {$max}C "

[[block]]
block = "load"
interval = 1

[[block]]
block = "cpu"
# format = " $icon $utilization.bar_graph(w:32) $barchart $utilization "
interval = 1

# Start of notification blocks


[[block]]
block = "battery"
interval = 1
{{- if eq .chezmoi.hostname "bmalyn-tower" }}
driver = "apc_ups"
format = " $icon $percentage $time_remaining.duration(hms, min_unit:m) {$power|N/A} "
full_format = " $icon Full $time_remaining.duration(hms, min_unit:m) {$power|N/A} "
{{- else if eq .chezmoi.hostname "bmalyn-yoga" }}
device = "BAT1"
format = " $icon {$percentage} {$time_remaining.duration(hms, min_unit:m)} "
full_format = " $icon Full "
{{- end }}


[[block]]
block = "backlight"

[[block]]
block = "hueshift"
click_temp = 4500

[[block]]
block = "sound"
driver = "pipewire"
format = " $icon $output_name {$volume.eng(w:3)|} "
[[block.click]]
button = "left"
cmd = "nextSink.py"
[block.theme_overrides]
warning_bg = { link = "idle_bg" }
warning_fg = { link = "idle_fg" }
[block.mappings]
"alsa_output\\..*\\.hdmi-stereo.*" = "\uf390"
"alsa_output\\.usb-Focusrite_Scarlett_Solo_USB_Y7RRZHQ19D3BE3-00\\..*" = "\U000f02cb"

[[block]]
block = "privacy"
[[block.driver]]
name = "v4l"
[[block.driver]]
name = "pipewire"
exclude_input = ["openrgb", "PulseAudio Volume Control"]
display = "nickname"

[[block]]
block = "keyboard_layout"
driver = "sway"
format = " $layout "      # $variant
[block.mappings]
"English (US)" = "en"
"Swedish (no dead keys)" = "sv"

[[block]]
block = "packages"
package_manager = ["pacman", "aur", "flatpak"]
format_up_to_date = ""
critical_updates_regex = "(linux|linux-lts|linux-zen)"
aur_command = "paru -Qua"
interval = 3600
error_interval = 3600
[[block.click]]
button = "left"
cmd = "{ echo paru; fakeroot paru -Qu --dbpath /tmp/checkup-db-i3statusrs-$USER/ | grep -v '\\[ignored\\]$'; echo =======================; echo flatpak; flatpak remote-ls --updates --columns=ref,version; } | bemenu -l 20"
[[block.click]]
# Updates the block on right click
button = "right"
update = true


[[block]]
block = "notify"
format = " $icon {$notification_count.eng(w:1) |}"
driver = "swaync"
[[block.click]]
button = "left"
action = "show"
[[block.click]]
button = "right"
action = "toggle_paused"

[[block]]
block = "time"
format = [
    " $icon $timestamp.datetime(f:'%a %Y-%m-%d %R %z') ",
    " $icon $timestamp.datetime(f:full, l:en-u-ca-hebrew-hc-h23, p:m) $timestamp.datetime(f:'%z') ",
]
[[block.click]]
button = "left"
action = "next_format"
[[block.click]]
button = "right"
action = "prev_format"

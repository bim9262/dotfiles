#!/bin/bash

cwd=${PWD##*/}

echo -e Project: '\t' $cwd
echo -e Server: '\t' $1
echo -e  Command: '\t' $2
echo ================================================================================
echo Ready
while inotifywait -q --exclude '(.git|COMMIT_EDITMSG)'  -e modify .
do
	echo Syncing
	rsync --info=flist0 -uarhz --progress --exclude '.git' . $1:~/$cwd
	echo ================================================================================
	echo Executing
	echo ================================================================================
	ssh $1 "cd $cwd && $2"
	echo ================================================================================
	echo Ready
done
